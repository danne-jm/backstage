################################################################################
#                                                                              #
#                                    COMMON                                    #
#                                                                              #
################################################################################

# Application
APP_NAME="Backstage Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# PHP
PHP_CLI_SERVER_WORKERS=10
BCRYPT_ROUNDS=12

# Maintenance
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# CORS
CORS_ALLOWED_ORIGINS="http://localhost,http://127.0.0.1"
EMAIL_ALLOWED_ORIGINS=

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backstage
DB_USERNAME=root
DB_PASSWORD=

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache
CACHE_STORE=redis
# CACHE_PREFIX=

# Queue
QUEUE_CONNECTION=redis

# Filesystem
FILESYSTEM_DISK=local

# Memcached
MEMCACHED_HOST=127.0.0.1

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# AWS (unused)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Vite
#VITE_APP_NAME="${APP_NAME}"


################################################################################
#                                                                              #
#                                  BACKSTAGE                                   #
#                                                                              #
################################################################################

BACKSTAGE_APP_NAME="XYZ Backstage"

BACKSTAGE_APP_URL=http://localhost

# Broadcasting
BROADCAST_CONNECTION=reverb

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${BACKSTAGE_APP_URL}/auth/google/callback"

# Reverb WebSockets
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_SERVER_PORT=8080
REVERB_PORT=80
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- RUN BY SUPERVISOR
#php artisan queue:work --queue=distributions,default
#php artisan reverb:start
#* * * * * cd /path/to/your/project && php artisan schedule:run >> /dev/null 2>&1


################################################################################
#                                                                              #
#                                    STORE                                     #
#                                                                              #
################################################################################

STORE_APP_NAME="XYZ"

STORE_APP_URL=http://localhost:8000

# Social Media Links
LINKTREE_URL=
INSTAGRAM_URL=
FACEBOOK_URL=
WEBSITE_URL=
TIKTOK_URL=

# Payment - SumUp
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_RETURN_URL="${STORE_APP_URL}/payment/callback"
SUMUP_PROCESSING_FEE_RATE=0.0169
SUMUP_WEBHOOK_SECRET=
#Configure webhook URL in SumUp dashboard to point to: ${BACKSTAGE_APP_URL}/payment/webhook

# Branding
COPYRIGHT="XYZ - All rights reserved."

APP_TIMEZONE='Europe/Brussels'